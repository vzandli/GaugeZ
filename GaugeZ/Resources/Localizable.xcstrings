          "stringUnit" : {
            "state" : "translated",
            "value" : "Для доступа с клавиатуры выберите «Использование…» в меню GaugeZ в строке меню."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விசைப்பலகை அணுகலுக்கு, GaugeZ மெனு பார் மெனுவில் பயன்பாடு… என்பதைத் தேர்ந்தெடுக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "కీబోర్డ్ యాక్సెస్ కోసం, GaugeZ మెనూ బార్ మెనూలో వినియోగం… ఎంచుకోండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
