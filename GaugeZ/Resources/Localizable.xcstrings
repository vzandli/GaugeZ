    "Open the rail for six seconds when a window reaches 0% remaining" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فتح الشريط لمدة ست ثوانٍ عندما يصل المتبقي في إحدى النوافذ إلى 0%"
          }
