    "Reads the local Antigravity server, then Google quota with the saved sign-in, or derives model turns from local transcripts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ خادم Antigravity المحلي، ثم حصة Google باستخدام تسجيل الدخول المحفوظ، أو يشتق أدوار النموذج من النصوص المحلية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্থানীয় Antigravity সার্ভার পড়ে, তারপর সংরক্ষিত সাইন-ইন দিয়ে Google কোটা পড়ে, অথবা স্থানীয় ট্রান্সক্রিপ্ট থেকে মডেল টার্ন অনুমান করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čita lokalni Antigravity server, zatim Google kvotu sa sačuvanom prijavom, ili izvodi interakcije modela iz lokalnih transkripata."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest den lokalen Antigravity-Server, dann das Google-Kontingent mit der gespeicherten Anmeldung oder leitet Modell-Züge aus lokalen Transkripten ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads the local Antigravity server, then Google quota with the saved sign-in, or derives model turns from local transcripts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee el servidor local de Antigravity, luego la cuota de Google con la sesión guardada, o deduce los turnos del modelo de las transcripciones locales."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabasa ang lokal na server ng Antigravity, pagkatapos ay ang Google quota gamit ang naka-save na pag-sign in, o hinahango ang mga model turn mula sa mga lokal na transcript."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit le serveur local d’Antigravity, puis le quota Google avec la connexion enregistrée, ou déduit les tours de modèle des historiques locaux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थानीय Antigravity सर्वर को पढ़ता है, फिर सहेजे गए साइन-इन के साथ Google कोटा पढ़ता है, या स्थानीय ट्रांसक्रिप्ट से मॉडल टर्न का अनुमान लगाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge il server locale di Antigravity, quindi la quota Google con l’accesso salvato, oppure ricava i turni del modello dalle trascrizioni locali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルのAntigravityサーバー、保存されたサインイン情報によるGoogleクォータを読み取るか、ローカルのログからモデルターン数を推計します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 Antigravity 서버 및 저장된 로그인으로 Google 할당량을 읽거나, 로컬 대화 기록에서 모델 턴을 추정합니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थानिक Antigravity सर्व्हर वाचते, नंतर जतन केलेल्या साइन-इनसह Google कोटा वाचते किंवा स्थानिक ट्रान्सक्रिप्टवरून मॉडेल टर्न काढते."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê o servidor local do Antigravity e a cota do Google com a sessão salva, ou deduz as interações das transcrições locais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считывает данные локального сервера Antigravity, затем квоту Google по сохраненному входу или вычисляет обращения к модели по локальным журналам."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உள்ளூர் Antigravity சேவையகத்தைப் படிக்கிறது, பின்னர் சேமித்த உள்நுழைவுடன் Google ஒதுக்கீட்டைப் படிக்கிறது, அல்லது உள்ளூர் டிரான்ஸ்கிரிப்டுகளிலிருந்து மாடல் திருப்பங்களைப் பெறுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్థానిక Antigravity సర్వర్‌ను, ఆపై సేవ్ చేసిన సైన్-ఇన్‌తో Google కోటాను చదువుతుంది, లేదా స్థానిక ట్రాన్స్‌క్రిప్ట్‌ల నుండి మోడల్ టర్న్‌లను లెక్కిస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel Antigravity sunucusunu, ardından kayıtlı girişle Google kotasını okur veya yerel kayıtlardan model turlarını türetir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقامی Antigravity سرور کو پڑھتا ہے، پھر محفوظ شدہ سائن ان کے ساتھ Google کوٹہ، یا مقامی ٹرانسکرپٹس سے ماڈل کے ٹرنز حاصل کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc máy chủ Antigravity cục bộ, sau đó đọc hạn mức Google bằng đăng nhập đã lưu hoặc suy ra các lượt mô hình từ bản ghi cục bộ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀取本機 Antigravity 伺服器，再使用已儲存的登入資訊讀取 Google 配額，或從本機記錄推斷模型對話輪次。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取本地 Antigravity 服务器，然后使用已保存的登录信息读取 Google 配额，或从本地记录中推导模型轮次。"
          }
        }
      }
    },
