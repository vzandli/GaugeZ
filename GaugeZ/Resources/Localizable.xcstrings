    "Reads Claude Desktop's sign-in via Keychain for live reset times, or falls back to the desktop usage log." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ تسجيل دخول Claude Desktop عبر سلسلة المفاتيح لأوقات إعادة التعيين المباشرة، أو يعتمد كبديل على سجل استخدام تطبيق سطح المكتب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লাইভ রিসেটের সময়ের জন্য কীচেনের মাধ্যমে Claude Desktop-এর সাইন-ইন পড়ে, অথবা ডেস্কটপ ব্যবহারের লগে ফিরে যায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čita prijavu aplikacije Claude Desktop putem Keychaina za vrijeme resetovanja uživo ili koristi zapisnik korištenja desktop aplikacije."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest die Anmeldung von Claude Desktop über den Schlüsselbund für Live-Rücksetzzeiten oder greift auf das Desktop-Nutzungsprotokoll zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads Claude Desktop's sign-in via Keychain for live reset times, or falls back to the desktop usage log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee el inicio de sesión de Claude Desktop a través del Llavero para obtener tiempos de restablecimiento en tiempo real, o recurre al registro de uso del escritorio."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabasa ang pag-sign in ng Claude Desktop sa pamamagitan ng Keychain para sa live na oras ng pag-reset, o bumabalik sa desktop usage log."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit la connexion de Claude Desktop via le trousseau d’accès pour les temps de réinitialisation, ou se rabat sur le journal d’utilisation de bureau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लाइव रीसेट समय के लिए कीचेन के माध्यम से Claude Desktop का साइन-इन पढ़ता है, या डेस्कटॉप उपयोग लॉग का उपयोग करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge l’accesso a Claude Desktop tramite il Portachiavi per i tempi di azzeramento in tempo reale, oppure ripiega sul registro di utilizzo dell’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーチェーン経由でClaude Desktopのサインイン情報を読み取りリアルタイムのリセット時刻を取得するか、デスクトップの使用ログにフォールバックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 초기화 시간을 위해 키체인을 통해 Claude Desktop의 로그인을 읽거나, 데스크탑 사용 로그로 대체합니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "थेट रीसेट वेळेसाठी कीचेनद्वारे Claude Desktop चे साइन-इन वाचते किंवा डेस्कटॉप वापर लॉगवर परत जाते."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê a sessão do Claude Desktop via Chaves para obter horários de reinicialização em tempo real, ou recorre ao registro de uso do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Считывает вход в Claude Desktop через Связку ключей для получения времени сброса в реальном времени или использует локальный журнал."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நேரலை மீட்டமைப்பு நேரங்களுக்காக கீசெயின் வழியாக Claude Desktop-இன் உள்நுழைவைப் படிக்கிறது, அல்லது டெஸ்க்டாப் பயன்பாட்டுப் பதிவிற்கு மாறுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లైవ్ రీసెట్ సమయాల కోసం Keychain ద్వారా Claude Desktop సైన్-ఇన్‌ను చదువుతుంది, లేదా డెస్క్‌టాప్ వినియోగ లాగ్‌ను ఉపయోగిస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canlı sıfırlama zamanları için Anahtar Zinciri aracılığıyla Claude Desktop girişini okur veya masaüstü kullanım günlüğüne geri döner."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لائیو ری سیٹ کے اوقات کے لیے کی چین کے ذریعے Claude Desktop کا سائن ان پڑھتا ہے، یا ڈیسک ٹاپ استعمال کے لاگ پر انحصار کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc thông tin đăng nhập Claude Desktop qua Chuỗi khóa để biết thời điểm đặt lại trực tiếp, hoặc quay về nhật ký sử dụng trên máy tính."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過「鑰匙圈」讀取 Claude 桌面版的登入資訊以取得即時重設時間，或改用桌面版用量記錄。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过钥匙串读取 Claude Desktop 的登录凭据以获取实时重置时间，或回退至桌面用量日志。"
          }
        }
      }
    },
    "Reads Command Code credits with the sign-in its CLI keeps in ~/.commandcode." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ رصيد Command Code باستخدام تسجيل الدخول الذي تحتفظ به واجهة سطر الأوامر في ~/.commandcode."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর CLI ~/.commandcode-এ রাখা সাইন-ইন দিয়ে Command Code ক্রেডিট পড়ে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čita Command Code kredite pomoću prijave koju njegov CLI čuva u ~/.commandcode."
