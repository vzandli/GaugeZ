    "This Grok account cannot access the subscription usage endpoint. Check your account in Grok Build." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لحساب Grok هذا الوصول إلى نقطة نهاية استخدام الاشتراك. تحقق من حسابك في Grok Build."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই Grok অ্যাকাউন্ট সাবস্ক্রিপশন ব্যবহার এন্ডপয়েন্টে অ্যাক্সেস করতে পারছে না। Grok Build-এ আপনার অ্যাকাউন্ট পরীক্ষা করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj Grok račun ne može pristupiti krajnjoj tački korištenja pretplate. Provjerite svoj račun u Grok Build."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Grok-Konto kann nicht auf den Endpunkt für die Abonnementnutzung zugreifen. Überprüfen Sie Ihr Konto in Grok Build."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Grok account cannot access the subscription usage endpoint. Check your account in Grok Build."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta de Grok no puede acceder al punto de conexión de uso de la suscripción. Comprueba tu cuenta en Grok Build."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ma-access ng Grok account na ito ang subscription usage endpoint. Suriin ang iyong account sa Grok Build."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte Grok ne peut pas accéder au point de terminaison d’utilisation de l’abonnement. Vérifiez votre compte dans Grok Build."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह Grok खाता सदस्यता उपयोग एंडपॉइंट तक नहीं पहुंच सकता। Grok Build में अपना खाता जांचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo account Grok non può accedere all’endpoint per l’utilizzo dell’abbonamento. Controlla il tuo account in Grok Build."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このGrokアカウントはサブスクリプション使用状況エンドポイントにアクセスできません。Grok Buildでアカウントを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Grok 계정은 구독 사용량 엔드포인트에 접근할 수 없습니다. Grok Build에서 계정을 확인하십시오."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे Grok खाते सदस्यत्व वापर एंडपॉइंटवर प्रवेश करू शकत नाही. Grok Build मध्ये आपले खाते तपासा."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta do Grok não tem acesso ao ponto de uso da assinatura. Verifique sua conta no Grok Build."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У этой учетной записи Grok нет доступа к данным использования подписки. Проверьте учетную запись в Grok Build."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இந்த Grok கணக்கால் சந்தா பயன்பாட்டு முனையத்தை அணுக முடியாது. Grok Build-இல் உங்கள் கணக்கைச் சரிபார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఈ Grok ఖాతా సబ్‌స్క్రిప్షన్ వినియోగ ఎండ్‌పాయింట్‌ను యాక్సెస్ చేయలేదు. Grok Build లో మీ ఖాతాను తనిఖీ చేయండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Grok hesabı abonelik kullanımı uç noktasına erişemiyor. Hesabınızı Grok Build'de denetleyin."
