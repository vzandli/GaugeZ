    "Reads the Claude Code CLI sign-in from Keychain and asks Claude directly. macOS will ask you to allow it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ تسجيل دخول واجهة سطر أوامر Claude Code من سلسلة المفاتيح ويطلب من Claude مباشرة. سيطلب منك macOS السماح بذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কীচেন থেকে Claude Code CLI সাইন-ইন পড়ে এবং সরাসরি Claude-কে অনুরোধ করে। macOS এটি অনুমোদন করতে বলবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čita prijavu za Claude Code CLI iz Keychaina i direktno pita Claude. macOS će od vas tražiti dozvolu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest die Anmeldung des Claude Code-CLI aus dem Schlüsselbund und fragt Claude direkt ab. macOS wird um Erlaubnis bitten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads the Claude Code CLI sign-in from Keychain and asks Claude directly. macOS will ask you to allow it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee el inicio de sesión de Claude Code CLI desde el Llavero y consulta directamente a Claude. macOS te pedirá autorización."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binabasa ang pag-sign in ng Claude Code CLI mula sa Keychain at direktang nagtatanong sa Claude. Hihilingin sa iyo ng macOS na payagan ito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit la connexion du CLI Claude Code dans le trousseau d’accès et interroge Claude directement. macOS vous demandera l’autorisation."
