    "Anchor GaugeZ to any screen edge, or drag the rail's handle to one" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت GaugeZ على أي حافة شاشة، أو اسحب مقبض الشريط إلى إحداها"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্ক্রিনের যেকোনো প্রান্তে GaugeZ অ্যাঙ্কর করুন, বা রেলের হ্যান্ডেলটি কোনো প্রান্তে টেনে নিন"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pričvrstite GaugeZ za bilo koju ivicu ekrana ili povucite ručku trake do neke ivice"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ an einem beliebigen Bildschirmrand verankern oder die Leiste am Griff dorthin ziehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anchor GaugeZ to any screen edge, or drag the rail's handle to one"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fija GaugeZ a cualquier borde de la pantalla, o arrastra la barra por su control hasta uno"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-anchor ang GaugeZ sa anumang gilid ng screen, o i-drag ang hawakan ng rail papunta sa isa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancrer GaugeZ à n’importe quel bord de l’écran, ou y faire glisser le rail par sa poignée"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन के किसी भी किनारे पर GaugeZ को एंकर करें, या रेल के हैंडल को किसी किनारे तक खींचें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggancia GaugeZ a qualsiasi bordo dello schermo o trascina la barra per la maniglia fino a un bordo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZを任意の画面端に固定するか、レールのハンドルを画面端にドラッグします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ를 원하는 화면 가장자리에 고정하거나 레일의 손잡이를 가장자리로 드래그하십시오"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीनच्या कोणत्याही काठावर GaugeZ अँकर करा, किंवा रेलचे हँडल एखाद्या काठावर ड्रॅग करा"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixe o GaugeZ em qualquer borda da tela ou arraste a barra pela alça até uma delas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прикрепите GaugeZ к любому краю экрана или перетащите панель за маркер к нужному краю"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ-ஐ திரையின் ஏதேனும் ஒரு விளிம்பில் இணைக்கவும், அல்லது ரயிலின் கைப்பிடியை ஒரு விளிம்புக்கு இழுக்கவும்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZని ఏదైనా స్క్రీన్ అంచుకు యాంకర్ చేయండి, లేదా రైల్ హ్యాండిల్‌ను ఒక అంచుకు లాగండి"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ'yi herhangi bir ekran kenarına sabitleyin ya da şeridi tutamacından bir kenara sürükleyin"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ کو اسکرین کے کسی بھی کنارے سے جوڑیں، یا ریل کے ہینڈل کو کسی کنارے تک ڈریگ کریں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghim GaugeZ vào bất kỳ cạnh màn hình nào, hoặc kéo tay cầm của thanh viền tới một cạnh"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 GaugeZ 固定至任何螢幕邊緣，或將邊欄的把手拖至邊緣"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 GaugeZ 固定到任意屏幕边缘，或把边栏的手柄拖到某个边缘"
          }
        }
      }
    },
