    "Removes GaugeZ settings, cached readings, and launch-at-login registration. Your provider accounts and credentials stay in their own apps." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل إعدادات GaugeZ والقراءات المخزنة مؤقتًا والتسجيل في الفتح عند تسجيل الدخول. تظل حسابات المزودين وبيانات الاعتماد الخاصة بك في تطبيقاتها الخاصة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ সেটিংস, ক্যাশ করা রিডিং এবং লগইন-চালু নিবন্ধন মুছে ফেলে। আপনার প্রদানকারী অ্যাকাউন্ট ও লগইন তথ্য তাদের নিজস্ব অ্যাপে সুরক্ষিত থাকে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uklanja postavke aplikacije GaugeZ, keširana očitanja i registraciju pokretanja pri prijavi. Računi pružalaca usluga i prijavni podaci ostaju u njihovim aplikacijama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt GaugeZ-Einstellungen, zwischengespeicherte Messwerte und die Autostart-Registrierung. Ihre Anbieterkonten und Anmeldedaten verbleiben in ihren jeweiligen Apps."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes GaugeZ settings, cached readings, and launch-at-login registration. Your provider accounts and credentials stay in their own apps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina los ajustes de GaugeZ, las lecturas en caché y el inicio automático. Tus cuentas y credenciales de los proveedores permanecen en sus propias apps."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaalis ang mga setting ng GaugeZ, mga naka-cache na pagbasa, at pagpaparehistro ng paglunsad sa pag-login. Nananatili ang iyong mga provider account at kredensyal sa sarili nilang mga app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime les réglages de GaugeZ, les relevés en cache et l’enregistrement au démarrage. Vos comptes et identifiants de fournisseurs restent dans leurs applications respectives."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ सेटिंग्स, कैश्ड डेटा और लॉगिन पर लॉन्च पंजीकरण हटाता है। आपके प्रदाता खाते और क्रेडेंशियल उनके अपने ऐप्स में रहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove le impostazioni di GaugeZ, i dati in cache e l’avvio automatico al login. I tuoi account e le credenziali dei provider rimangono nelle rispettive app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZの設定、キャッシュされた読み取り値、ログイン時起動の登録を削除します。プロバイダーのアカウントおよび認証情報は元のアプリに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ 설정, 캐시된 측정값 및 로그인 시 실행 등록을 제거합니다. 제공자 계정 및 자격 증명은 각 앱에 그대로 유지됩니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ सेटिंग्ज, कॅश केलेले रीडिंग्ज आणि लाँच-अ‍ॅट-लॉगिन नोंदणी काढून टाकते. तुमची प्रदाता खाती आणि क्रेडेंशियल्स त्यांच्या स्वतःच्या अ‍ॅप्समध्ये राहतात."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove os ajustes do GaugeZ, leituras em cache e inicialização com o sistema. Suas contas e credenciais continuam salvas nos respectivos apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет настройки GaugeZ, кэшированные данные и запуск при входе. Учетные записи и данные провайдеров останутся в их приложениях."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ அமைப்புகள், தற்காலிக சேமிப்பு வாசிப்புகள் மற்றும் தொடக்கப் பதிவு ஆகியவற்றை நீக்குகிறது. உங்கள் வழங்குநர் கணக்குகளும் சான்றுகளும் அவற்றின் சொந்த செயலிகளிலேயே இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ సెట్టింగ్‌లు, కాష్ చేసిన రీడింగ్‌లు మరియు లాగిన్ ప్రారంభ నమోదును తీసివేస్తుంది. మీ ప్రొవైడర్ ఖాతాలు మరియు ఆధారాలు వాటి స్వంత యాప్‌లలోనే ఉంటాయి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ ayarlarını, önbelleğe alınmış ölçümleri ve girişte başlatma kaydını kaldırır. Sağlayıcı hesaplarınız ve kimlik bilgileriniz kendi uygulamalarında kalır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ کی ترتیبات، کیش شدہ ریڈنگز، اور لاگ ان پر لانچ کی رجسٹریشن ہٹاتا ہے۔ آپ کے فراہم کنندہ اکاؤنٹس اور اسناد ان کی اپنی ایپس میں محفوظ رہتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa cài đặt GaugeZ, các số liệu trong bộ đệm và đăng ký khởi chạy khi đăng nhập. Tài khoản nhà cung cấp và thông tin xác thực của bạn vẫn lưu trong ứng dụng riêng của họ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 GaugeZ 設定、快取讀數以及登入時啟動設定。你的提供者帳戶及憑證會保留在各自的應用程式中。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除 GaugeZ 设置、缓存数据和登录启动项注册。您的提供方账号与凭据将保留在其各自的应用中。"
          }
        }
      }
    },
