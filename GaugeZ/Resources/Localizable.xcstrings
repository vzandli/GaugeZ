    "macOS could not update the login item. Move GaugeZ to Applications and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على macOS تحديث عنصر تسجيل الدخول. انقل GaugeZ إلى مجلد التطبيقات وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS লগইন আইটেম আপডেট করতে পারেনি। GaugeZ-কে Applications ফোল্ডারে নিয়ে যান এবং আবার চেষ্টা করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nije mogao ažurirati stavku za prijavu. Premjestite GaugeZ u Aplikacije (Applications) i pokušajte ponovo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS konnte das Anmeldeobjekt nicht aktualisieren. Verschieben Sie GaugeZ in den Ordner „Programme“ und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS could not update the login item. Move GaugeZ to Applications and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no pudo actualizar el elemento de inicio. Mueve GaugeZ a Aplicaciones e inténtalo de nuevo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
