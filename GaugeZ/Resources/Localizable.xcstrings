    "Use the slider or drag the notch's inner edge" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم شريط التمرير أو اسحب الحافة الداخلية للمؤشر"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "স্লাইডার ব্যবহার করুন বা নচের ভেতরের প্রান্তটি টানুন"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristite klizač ili povucite unutrašnju ivicu ureza"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schieberegler verwenden oder an der Innenkante der Kerbe ziehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the slider or drag the notch's inner edge"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el control deslizante o arrastra el borde interior de la muesca"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang slider o i-drag ang panloob na gilid ng notch"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le curseur ou faites glisser le bord intérieur de l’encoche"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्लाइडर का उपयोग करें या नॉच के आंतरिक किनारे को खींचें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il cursore o trascina il bordo interno della tacca"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スライダーを使用するか、ノッチの内側の端をドラッグ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "슬라이더를 사용하거나 노치의 안쪽 가장자리를 드래그하십시오"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्लायडर वापरा किंवा नॉचची आतील किनार ड्रॅग करा"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o controle deslizante ou arraste a borda interna do entalhe"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте ползунок или перетащите внутренний край выреза"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஸ்லைடரைப் பயன்படுத்தவும் அல்லது நாட்ச்சின் உட்புற விளிம்பை இழுக்கவும்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "స్లైడర్‌ని ఉపయోగించండి లేదా నాచ్ లోపలి అంచుని లాగండి"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaydırıcıyı kullanın veya çentiğin iç kenarını sürükleyin"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سلائیڈر کا استعمال کریں یا نوچ کے اندرونی کنارے کو ڈریگ کریں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dùng thanh trượt hoặc kéo cạnh trong của rãnh khuyết"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用滑桿或拖曳凹口內緣"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用滑块或拖动凹口内边缘"
          }
        }
      }
    },
    "Uses Cursor's local sign-in to ask cursor.com for plan usage." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم تسجيل دخول Cursor المحلي لسؤال cursor.com عن استخدام الخطة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্ল্যান ব্যবহারের জন্য cursor.com-এর কাছে জানতে Cursor-এর স্থানীয় সাইন-ইন ব্যবহার করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi lokalnu prijavu za Cursor da zatraži korištenje plana od cursor.com."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet die lokale Anmeldung von Cursor, um die Tarifnutzung bei cursor.com abzufragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses Cursor's local sign-in to ask cursor.com for plan usage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el inicio de sesión local de Cursor para consultar el uso del plan en cursor.com."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ginagamit ang lokal na pag-sign in ng Cursor upang tanungin ang cursor.com para sa paggamit ng plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise la connexion locale de Cursor pour interroger cursor.com sur l’utilisation du forfait."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लान उपयोग के लिए cursor.com से पूछने हेतु Cursor के स्थानीय साइन-इन का उपयोग करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa l’accesso locale di Cursor per verificare l’utilizzo del piano su cursor.com."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursorのローカルサインイン情報を使用してcursor.comにプラン使用状況を問い合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor의 로컬 로그인을 사용하여 cursor.com에 요금제 사용량을 요청합니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "योजना वापरासाठी cursor.com ला विचारण्यासाठी Cursor च्या स्थानिक साइन-इनचा वापर करते."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa a sessão local do Cursor para consultar o uso do plano em cursor.com."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует локальный вход в Cursor для запроса использования плана на cursor.com."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "திட்டப் பயன்பாட்டைக் கேட்க Cursor-இன் உள்ளூர் உள்நுழைவைப் பயன்படுத்தி cursor.com-ஐ அணுகுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్లాన్ వినియోగాన్ని అడగడానికి Cursor స్థానిక సైన్-ఇన్‌ను ఉపయోగించి cursor.com ని సంప్రదిస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plan kullanımını cursor.com'a sormak için Cursor'ın yerel girişini kullanır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پلان کے استعمال کے بارے میں cursor.com سے پوچھنے کے لیے Cursor کا مقامی سائن ان استعمال کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng đăng nhập cục bộ của Cursor để hỏi cursor.com về mức sử dụng gói."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Cursor 的本機登入向 cursor.com 查詢方案用量。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Cursor 本地登录凭据向 cursor.com 查询方案用量。"
          }
        }
      }
    },
