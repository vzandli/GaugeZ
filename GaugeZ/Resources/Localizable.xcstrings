    "OpenCode rejected the Go key, or this key has no Go plan. Sign in to OpenCode again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض OpenCode مفتاح Go، أو لا يحتوي هذا المفتاح على خطة Go. سجّل الدخول إلى OpenCode مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Go কী প্রত্যাখ্যান করেছে, অথবা এই কীতে কোনো Go প্ল্যান নেই। OpenCode-এ আবার সাইন ইন করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode je odbio Go ključ ili ovaj ključ nema Go plan. Ponovo se prijavite na OpenCode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode hat den Go-Schlüssel abgelehnt oder dieser Schlüssel hat keinen Go-Tarif. Melden Sie sich erneut bei OpenCode an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode rejected the Go key, or this key has no Go plan. Sign in to OpenCode again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode rechazó la clave de Go, o esta clave no tiene un plan Go. Inicia sesión en OpenCode de nuevo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinanggihan ng OpenCode ang Go key, o walang Go plan ang key na ito. Mag-sign in muli sa OpenCode."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode a rejeté la clé Go, ou cette clé n’a aucun forfait Go. Reconnectez-vous à OpenCode."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode ने Go कुंजी अस्वीकार कर दी, या इस कुंजी में कोई Go प्लान नहीं है। OpenCode में फिर से साइन इन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode ha rifiutato la chiave Go o questa chiave non ha un piano Go. Accedi nuovamente a OpenCode."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCodeがGoキーを拒否したか、このキーにGoプランがありません。OpenCodeに再度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode가 Go 키를 거부했거나 이 키에 Go 플랜이 없습니다. OpenCode에 다시 로그인하십시오."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode ने Go की नाकारली किंवा या की वर कोणतीही Go योजना नाही. OpenCode मध्ये पुन्हा साइन इन करा."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OpenCode rejeitou a chave Go ou esta chave não possui um plano Go. Inicie sessão no OpenCode novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode отклонил ключ Go, или для этого ключа нет плана Go. Войдите в OpenCode снова."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Go விசையை நிராகரித்தது, அல்லது இந்த விசையில் Go திட்டம் இல்லை. OpenCode-இல் மீண்டும் உள்நுழையவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode Go కీని తిరస్కరించింది, లేదా ఈ కీకి Go ప్లాన్ లేదు. మళ్లీ OpenCode లోకి సైన్ ఇన్ చేయండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode, Go anahtarını reddetti veya bu anahtarın Go planı yok. OpenCode'a tekrar giriş yapın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode نے Go کلید کو مسترد کر دیا، یا اس کلید میں کوئی Go پلان نہیں ہے۔ OpenCode میں دوبارہ سائن ان کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode đã từ chối khóa Go hoặc khóa này không có gói Go. Hãy đăng nhập lại vào OpenCode."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode 拒絕了 Go 金鑰，或此金鑰沒有 Go 方案。請重新登入 OpenCode。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode 拒绝了 Go 密钥，或该密钥未包含 Go 方案。请重新登录 OpenCode。"
          }
        }
      }
    },
