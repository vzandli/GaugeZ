          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un accès au clavier, choisissez Utilisation… dans le menu de GaugeZ de la barre des menus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीबोर्ड एक्सेस के लिए, GaugeZ मेनू बार मेनू में 'उपयोग…' चुनें।"
