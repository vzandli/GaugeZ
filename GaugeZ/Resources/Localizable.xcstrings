    "Kimi rejected the saved session. Run kimi and sign in again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض Kimi الجلسة المحفوظة. شغّل kimi وسجّل الدخول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi সংরক্ষিত সেশন প্রত্যাখ্যান করেছে। kimi চালান এবং আবার সাইন ইন করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi je odbio sačuvanu sesiju. Pokrenite kimi i ponovo se prijavite."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi hat die gespeicherte Sitzung abgelehnt. Führen Sie kimi aus und melden Sie sich erneut an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi rejected the saved session. Run kimi and sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi rechazó la sesión guardada. Ejecuta kimi e inicia sesión de nuevo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinanggihan ng Kimi ang naka-save na session. Patakbuhin ang kimi at mag-sign in muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi a rejeté la session enregistrée. Exécutez kimi et reconnectez-vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi ने सहेजा गया सत्र अस्वीकार कर दिया। kimi चलाएं और फिर से साइन इन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi ha rifiutato la sessione salvata. Esegui kimi e accedi di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimiが保存されたセッションを拒否しました。kimiを実行して再度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi가 저장된 세션을 거부했습니다. kimi를 실행하고 다시 로그인하십시오."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi ने जतन केलेले सत्र नाकारले. kimi चालवा आणि पुन्हा साइन इन करा."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Kimi rejeitou a sessão salva. Execute kimi e inicie sessão novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi отклонил сохранённую сессию. Выполните kimi и войдите снова."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "சேமிக்கப்பட்ட அமர்வை Kimi நிராகரித்தது. kimi ஐ இயக்கி மீண்டும் உள்நுழையவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సేవ్ చేసిన సెషన్‌ను Kimi తిరస్కరించింది. kimi రన్ చేసి మళ్లీ సైన్ ఇన్ చేయండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi kayıtlı oturumu reddetti. kimi komutunu çalıştırıp tekrar giriş yapın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kimi نے محفوظ شدہ سیشن مسترد کر دیا۔ kimi چلائیں اور دوبارہ سائن ان کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
