        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीचेन से Claude Code CLI साइन-इन पढ़ता है और सीधे Claude से संपर्क करता है। macOS आपसे अनुमति मांगेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
