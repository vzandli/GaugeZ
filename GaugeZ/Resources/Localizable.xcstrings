    "Z.ai asked GaugeZ to wait before checking again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلب Z.ai من GaugeZ الانتظار قبل الفحص مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai আবার পরীক্ষা করার আগে GaugeZ-কে অপেক্ষা করতে বলেছে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai je zatražio od aplikacije GaugeZ da pričeka prije ponovne provjere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai hat GaugeZ gebeten, vor einer erneuten Prüfung zu warten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai asked GaugeZ to wait before checking again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai solicitó a GaugeZ esperar antes de volver a consultar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiniling ng Z.ai sa GaugeZ na maghintay bago sumuri muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai a demandé à GaugeZ d’attendre avant de revérifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai ने GaugeZ से दोबारा जांच करने से पहले प्रतीक्षा करने को कहा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai ha chiesto a GaugeZ di attendere prima di controllare di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.aiは再確認まで待機するようGaugeZに要求しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai가 다시 확인하기 전에 기다리도록 GaugeZ에 요청했습니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai ने पुन्हा तपासण्यापूर्वी GaugeZ ला थांबण्यास सांगितले."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Z.ai pediu para o GaugeZ aguardar antes de consultar novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z.ai запросил подождать перед повторной проверкой."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "மீண்டும் சரிபார்க்கும் முன் காத்திருக்குமாறு GaugeZ-ஐ Z.ai கேட்டுக் கொண்டது."
