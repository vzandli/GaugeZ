    "The Claude Code sign-in has expired. Open Claude Code once so it can refresh, then retry." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية تسجيل دخول Claude Code. افتح Claude Code مرة واحدة ليتمكن من التحديث، ثم أعد المحاولة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code সাইন-ইনের মেয়াদ শেষ। একবার Claude Code খুলুন যাতে এটি রিফ্রেশ হতে পারে, তারপর আবার চেষ্টা করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijava za Claude Code je istekla. Otvorite Claude Code jednom kako bi se osvježio, pa pokušajte ponovo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Claude Code-Anmeldung ist abgelaufen. Öffnen Sie Claude Code einmal zur Aktualisierung und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Claude Code sign-in has expired. Open Claude Code once so it can refresh, then retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión de Claude Code ha caducado. Abre Claude Code para que se actualice y vuelve a intentarlo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nag-expire na ang pag-sign in ng Claude Code. Buksan ang Claude Code nang isang beses upang mag-refresh ito, pagkatapos ay subukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion de Claude Code a expiré. Ouvrez Claude Code une fois pour l’actualiser, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code साइन-इन समाप्त हो गया है। एक बार Claude Code खोलें ताकि यह रीफ़्रेश हो सके, फिर पुनः प्रयास करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso a Claude Code è scaduto. Apri Claude Code per consentirne l’aggiornamento, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Codeのサインイン期限が切れました。更新するためにClaude Codeを一度開き、再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 로그인이 만료되었습니다. 갱신되도록 Claude Code를 한 번 연 후 다시 시도하십시오."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code साइन-इन कालबाह्य झाले आहे. एकदा Claude Code उघडा जेणेकरून ते रीफ्रेश होईल, नंतर पुन्हा प्रयत्न करा."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão do Claude Code expirou. Abra o Claude Code para atualizar a sessão e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок действия сеанса Claude Code истек. Запустите Claude Code один раз для обновления и повторите попытку."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code உள்நுழைவு காலாவதியானது. Claude Code புதுப்பிக்கப்படுவதற்கு அதை ஒரு முறை திறந்து, பின்னர் மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code సైన్-ఇన్ గడువు ముగిసింది. Claude Code రిఫ్రెష్ కావడానికి ఒకసారి తెరిచి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code girişinin süresi doldu. Yenilenebilmesi için Claude Code'u bir kez açın, ardından yeniden deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code کا سائن ان ختم ہو گیا ہے۔ Claude Code کو ایک بار کھولیں تاکہ یہ ریفریش ہو سکے، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đăng nhập Claude Code đã hết hạn. Mở Claude Code một lần để làm mới rồi thử lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 登入已過期。請開啟 Claude Code 一次以重新整理，然後重試。"
