    "Updates are verified with GaugeZ's signing key before they are installed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم التحقق من التحديثات باستخدام مفتاح توقيع GaugeZ قبل تثبيتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপডেট ইনস্টল করার আগে GaugeZ-এর সাইনিং কী দিয়ে যাচাই করা হয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ažuriranja se provjeravaju ključem za potpisivanje aplikacije GaugeZ prije instalacije."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates werden vor der Installation mit dem Signaturschlüssel von GaugeZ überprüft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Updates are verified with GaugeZ's signing key before they are installed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las actualizaciones se verifican con la clave de firma de GaugeZ antes de instalarse."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang mga update ay nabe-verify gamit ang signing key ng GaugeZ bago mai-install."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les mises à jour sont vérifiées avec la clé de signature de GaugeZ avant d’être installées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट इंस्टॉल करने से पहले GaugeZ की हस्ताक्षर कुंजी से सत्यापित किए जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli aggiornamenti vengono verificati con la chiave di firma di GaugeZ prima di essere installati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートはインストール前にGaugeZの署名鍵で検証されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업데이트는 설치되기 전에 GaugeZ 서명 키로 확인됩니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपडेट्स इन्स्टॉल करण्यापूर्वी GaugeZ च्या स्वाक्षरी की ने पडताळली जातात."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As atualizações são verificadas com a chave de assinatura do GaugeZ antes da instalação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновления проверяются ключом подписи GaugeZ перед установкой."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "புதுப்பிப்புகள் நிறுவப்படுவதற்கு முன் GaugeZ-இன் கையொப்பமிடும் விசையுடன் சரிபார்க்கப்படுகின்றன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అప్‌డేట్‌లు ఇన్‌స్టాల్ చేయడానికి ముందు GaugeZ సైనింగ్ కీతో ధృవీకరించబడతాయి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güncellemeler yüklenmeden önce GaugeZ'nin imza anahtarıyla doğrulanır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپ ڈیٹس انسٹال ہونے سے پہلے GaugeZ کی سائننگ کلید سے تصدیق کی جاتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bản cập nhật được xác minh bằng khóa ký của GaugeZ trước khi cài đặt."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新在安裝前會使用 GaugeZ 的簽署金鑰進行驗證。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新在安装前会使用 GaugeZ 的签名密钥进行验证。"
          }
        }
