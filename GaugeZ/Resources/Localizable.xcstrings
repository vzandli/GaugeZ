    "Grok Build’s login has expired. Open Grok Build so it refreshes the login, then retry." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت صلاحية تسجيل دخول Grok Build. افتح Grok Build لتحديث تسجيل الدخول، ثم أعد المحاولة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok Build-এর লগইনের মেয়াদ শেষ। Grok Build খুলুন যাতে এটি লগইন রিফ্রেশ করতে পারে, তারপর আবার চেষ্টা করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijava za Grok Build je istekla. Otvorite Grok Build da osvježi prijavu, pa pokušajte ponovo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung von Grok Build ist abgelaufen. Öffnen Sie Grok Build zur Aktualisierung der Anmeldung und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok Build’s login has expired. Open Grok Build so it refreshes the login, then retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio de sesión de Grok Build ha caducado. Abre Grok Build para actualizar la sesión y vuelve a intentarlo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nag-expire na ang pag-login ng Grok Build. Buksan ang Grok Build upang ma-refresh nito ang pag-login, pagkatapos ay subukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion de Grok Build a expiré. Ouvrez Grok Build pour actualiser la connexion, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok Build का लॉगिन समाप्त हो गया है। Grok Build खोलें ताकि लॉगिन रीफ़्रेश हो सके, फिर पुनः प्रयास करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso a Grok Build è scaduto. Apri Grok Build per aggiornare l’accesso, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok Buildのログイン期限が切れました。Grok Buildを開いてログインを更新してから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok Build 로그인이 만료되었습니다. Grok Build를 열어 로그인을 갱신한 후 다시 시도하십시오."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok Build चे लॉगिन कालबाह्य झाले आहे. Grok Build उघडा जेणेकरून लॉगिन रीफ्रेश होईल, नंतर पुन्हा प्रयत्न करा."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sessão do Grok Build expirou. Abra o Grok Build para atualizar o login e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Срок действия сеанса Grok Build истек. Откройте Grok Build для обновления авторизации и повторите попытку."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok Build-இன் உள்நுழைவு காலாவதியானது. உள்நுழைவைப் புதுப்பிக்க Grok Build-ஐத் திறந்து, மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grok Build లాగిన్ గడువు ముగిసింది. లాగిన్‌ను రిఫ్రెష్ చేయడానికి Grok Build తెరిచి, మళ్లీ ప్రయత్నించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
