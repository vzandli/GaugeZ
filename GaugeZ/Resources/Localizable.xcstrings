            "value" : "কীবোর্ড অ্যাক্সেসের জন্য, GaugeZ মেনু বার মেনুতে 'ব্যবহার…' নির্বাচন করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za pristup putem tastature, odaberite Korištenje… u meniju aplikacije GaugeZ na traci s menijem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Tastaturzugriff wählen Sie „Nutzung…“ im Menüleistenmenü von GaugeZ."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For keyboard access, choose Usage… in the GaugeZ menu bar menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para acceder mediante el teclado, elige Uso… en el menú de la barra de menús de GaugeZ."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
