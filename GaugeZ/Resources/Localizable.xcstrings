        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தினசரி வரவுசெலவுடன் Claude-ஐ வழிநடத்தவும்: ஒரு நாளைக்கு வாராந்திர வரம்பில் ஏழில் ஒரு பங்கு"
