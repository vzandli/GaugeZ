    "Devin is not signed in. Sign in inside Devin, or run devin auth login, then retry." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم تسجيل الدخول إلى Devin. سجّل الدخول داخل Devin، أو شغّل devin auth login، ثم أعد المحاولة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devin-এ সাইন ইন করা নেই। Devin-এ সাইন ইন করুন, বা devin auth login চালান, তারপর আবার চেষ্টা করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
