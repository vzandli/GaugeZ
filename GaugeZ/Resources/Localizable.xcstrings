    "GaugeZ stores only normalized usage observations—never tokens, credentials, or raw responses." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخزن GaugeZ ملاحظات الاستخدام الموحدة فقط — دون حفظ الرموز أو بيانات الاعتماد أو الاستجابات الأولية أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ শুধুমাত্র সাধারণ ব্যবহারের তথ্য সংরক্ষণ করে—কখনোই টোকেন, লগইন তথ্য বা অপরিশোধিত প্রতিক্রিয়া নয়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ pohranjuje samo normalizovana zapažanja korištenja—nikada tokene, prijavne podatke ili neobrađene odgovore."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ speichert nur normalisierte Nutzungsdaten – niemals Token, Anmeldedaten oder Rohdaten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ stores only normalized usage observations—never tokens, credentials, or raw responses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ solo almacena observaciones de uso normalizadas; nunca tokens, credenciales ni respuestas sin procesar."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nag-iimbak lamang ang GaugeZ ng mga na-normalize na obserbasyon sa paggamit—hindi kailanman mga token, kredensyal, o hilaw na tugon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ n’enregistre que des observations d’utilisation normalisées — jamais de jetons, d’identifiants ou de réponses brutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ केवल सामान्यीकृत उपयोग विवरण संग्रहीत करता है—टोकन, क्रेडेंशियल या रॉ प्रतिक्रियाएं कभी नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ memorizza solo osservazioni di utilizzo normalizzate, mai token, credenziali o risposte grezze."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZは正規化された使用状況の観測値のみを保存し、トークン、認証情報、生レスポンスを保存することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ는 정규화된 사용량 관측값만 저장하며 토큰, 자격 증명 또는 원시 응답을 저장하지 않습니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ केवळ सामान्यीकृत वापर निरीक्षणे साठवते—कधीही टोकन्स, क्रेडेंशियल्स किंवा रॉ प्रतिसाद नाही."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O GaugeZ armazena apenas dados de uso normalizados — nunca tokens, credenciais ou respostas brutas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ сохраняет только нормализованные данные об использовании, без токенов, учетных данных и необработанных ответов."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ இயல்பாக்கப்பட்ட பயன்பாட்டு அவதானிப்புகளை மட்டுமே சேமிக்கிறது—டோக்கன்கள், நற்சான்றிதழ்கள் அல்லது மூல பதில்களை ஒருபோதும் சேமிக்காது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ సాధారణీకరించిన వినియోగ పరిశీలనలను మాత్రమే నిల్వ చేస్తుంది—టోకెన్లు, ఆధారాలు లేదా ముడి ప్రతిస్పందనలను ఎప్పటికీ నిల్వ చేయదు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ yalnızca normalleştirilmiş kullanım gözlemlerini saklar; belirteçleri, kimlik bilgilerini veya ham yanıtları asla kaydetmez."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ صرف معمول کے مطابق استعمال کا ڈیٹا محفوظ کرتا ہے—کبھی بھی ٹوکنز، اسناد یا کچا رسپانس نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ chỉ lưu các quan sát mức sử dụng đã chuẩn hóa—không bao giờ lưu token, thông tin xác thực hay phản hồi thô."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ 僅儲存標準化的用量觀測資料——絕不儲存權杖、憑證或原始回應。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ 仅存储规范化的用量观察数据，绝不存储 Token、凭据或原始响应。"
          }
        }
      }
    },
