            "value" : "لا يمكن لـ GaugeZ قراءة auth.json الخاص بـ Grok Build. تحقق من أذونات الملف، ثم أعد المحاولة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ Grok Build-এর auth.json পড়তে পারছে না। ফাইল অনুমতি পরীক্ষা করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ ne može pročitati auth.json za Grok Build. Provjerite dozvole datoteke i pokušajte ponovo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ kann die auth.json von Grok Build nicht lesen. Überprüfen Sie die Dateiberechtigungen und versuchen Sie es erneut."
          }
