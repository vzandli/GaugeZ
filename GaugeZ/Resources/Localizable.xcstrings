    "See where each value came from and when it was last observed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاطلاع على مصدر كل قيمة ووقت آخر ملاحظة لها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতিটি মান কোথা থেকে এসেছে এবং কখন শেষ দেখা গেছে তা দেখুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pogledajte odakle potiče svaka vrijednost i kada je zadnji put zabilježena."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sehen Sie, woher jeder Wert stammt und wann er zuletzt erfasst wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See where each value came from and when it was last observed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta el origen de cada valor y cuándo se observó por última vez."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tingnan kung saan nagmula ang bawat value at kung kailan ito huling naobserbahan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voyez d’où provient chaque valeur et quand elle a été observée pour la dernière fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देखें कि प्रत्येक मान कहाँ से आया और इसे अंतिम बार कब देखा गया था।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica la provenienza di ciascun valore e quando è stato rilevato l’ultima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各値の取得元と前回の確認日時を確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 값의 출처와 마지막으로 관측된 시간을 확인합니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक मूल्य कोठून आले आणि ते शेवटचे कधी पाहिले गेले ते पहा."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja a origem de cada valor e quando foi registrado pela última vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Информация об источниках значений и времени последнего обновления."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒவ்வொரு மதிப்பும் எங்கிருந்து வந்தது மற்றும் கடைசியாக எப்போது கவனிக்கப்பட்டது என்பதைப் பார்க்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రతి విలువ ఎక్కడ నుండి వచ్చిందో మరియు చివరిసారిగా ఎప్పుడు గమనించబడిందో చూడండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her değerin nereden geldiğini ve en son ne zaman gözlemlendiğini görün."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دیکھیں کہ ہر ویلیو کہاں سے آئی اور آخری بار اس کا مشاہدہ کب کیا گیا تھا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem từng giá trị đến từ đâu và thời điểm ghi nhận gần nhất."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
