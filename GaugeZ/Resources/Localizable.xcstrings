    "Counts Gemini tokens from local CLI logs against a monthly budget you set." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسب رموز Gemini من سجلات واجهة سطر الأوامر المحلية مقابل ميزانية شهرية تحددها أنت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার নির্ধারিত মাসিক বাজেটের বিপরীতে স্থানীয় CLI লগ থেকে Gemini টোকেন গণনা করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broji Gemini tokene iz lokalnih CLI zapisa u odnosu na mjesečni budžet koji postavite."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zählt Gemini-Token aus lokalen CLI-Protokollen gegen ein von Ihnen festgelegtes Monatsbudget."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Counts Gemini tokens from local CLI logs against a monthly budget you set."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta los tokens de Gemini de los registros locales de la CLI frente a un presupuesto mensual que tú defines."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binibilang ang mga Gemini token mula sa lokal na CLI logs batay sa buwanang budget na itinakda mo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptabilise les jetons Gemini des journaux locaux du CLI par rapport à un budget mensuel que vous définissez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके तय किए मासिक बजट के विरुद्ध स्थानीय CLI लॉग से Gemini टोकन गिनता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta i token di Gemini dai log locali della CLI rispetto a un budget mensile impostato da te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルCLIログのGeminiトークン数を集計し、設定した月間予算と比較します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 CLI 로그의 Gemini 토큰을 직접 정한 월간 예산과 비교하여 집계합니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही ठरवलेल्या मासिक बजेटच्या तुलनेत स्थानिक CLI लॉगमधून Gemini टोकन्स मोजते."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conta os tokens do Gemini nos registros locais da CLI em relação a um orçamento mensal definido por você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подсчитывает токены Gemini из локальных журналов CLI в рамках заданного вами месячного бюджета."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீங்கள் அமைக்கும் மாதாந்திர வரவுசெலவுக்கு எதிராக உள்ளூர் CLI பதிவுகளிலிருந்து Gemini டோக்கன்களை எண்ணுகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు సెట్ చేసిన నెలవారీ బడ్జెట్‌తో పోల్చి స్థానిక CLI లాగ్‌ల నుండి Gemini టోకెన్లను లెక్కిస్తుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel CLI günlüklerindeki Gemini belirteçlerini, belirlediğiniz aylık bütçeye göre sayar."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے مقرر کردہ ماہانہ بجٹ کے مقابلے میں مقامی CLI لاگز سے Gemini ٹوکنز شمار کرتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đếm token Gemini từ nhật ký CLI cục bộ theo ngân sách hằng tháng bạn đặt."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根據本機 CLI 記錄統計 Gemini Token，並與你設定的每月預算比較。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据本地 CLI 日志统计 Gemini Token，并与你设定的月度预算比较。"
          }
        }
      }
    },
