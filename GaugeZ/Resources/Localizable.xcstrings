          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để truy cập bằng bàn phím, hãy chọn Mức sử dụng… trong menu thanh menu của GaugeZ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
