    "Clears GaugeZ’s cached reading. The enabled provider can refresh again later." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمسح القراءة المخزنة مؤقتًا في GaugeZ. يمكن للمزود المُمكّن التحديث مرة أخرى لاحقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ-এর ক্যাশ করা রিডিং সাফ করে। সক্ষম করা প্রদানকারী পরে আবার রিফ্রেশ করতে পারে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Briše keširano očitanje aplikacije GaugeZ. Omogućeni pružalac usluge može ga kasnije ponovo osvježiti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht den zwischengespeicherten Messwert von GaugeZ. Der aktivierte Anbieter kann später erneut aktualisiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clears GaugeZ’s cached reading. The enabled provider can refresh again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra la lectura en caché de GaugeZ. El proveedor habilitado podrá actualizarse más tarde."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binubura ang naka-cache na pagbasa ng GaugeZ. Maaaring mag-refresh muli ang pinaganang provider sa ibang pagkakataon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface le relevé en cache de GaugeZ. Le fournisseur activé pourra être actualisé ultérieurement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ के कैश्ड डेटा को साफ़ करता है। सक्षम प्रदाता बाद में फिर से रीफ़्रेश कर सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella la lettura in cache di GaugeZ. Il provider abilitato potrà essere aggiornato nuovamente in seguito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZにキャッシュされた読み取り値を消去します。有効なプロバイダーは後で再度更新できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ의 캐시된 측정값을 지웁니다. 활성화된 제공자는 나중에 다시 새로고침할 수 있습니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ चे कॅश केलेले रीडिंग साफ करते. सक्षम प्रदाता नंतर पुन्हा रीफ्रेश करू शकतो."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpa a leitura em cache do GaugeZ. O provedor ativado poderá atualizar novamente mais tarde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Очищает кэшированные данные GaugeZ. Включенный провайдер сможет обновиться позже."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ சேமித்துள்ள வாசிப்பை அழிக்கிறது. இயக்கப்பட்ட வழங்குநர் பின்னர் மீண்டும் புதுப்பிக்கலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ కాష్ చేసిన రీడింగ్‌ను క్లియర్ చేస్తుంది. ప్రారంభించబడిన ప్రొవైడర్ తర్వాత మళ్లీ రిఫ్రెష్ చేసుకోవచ్చు."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ'nin önbelleğe alınmış ölçümünü temizler. Etkin sağlayıcı daha sonra yeniden yenilenebilir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ کی کیش شدہ ریڈنگ صاف کرتا ہے۔ فعال فراہم کنندہ بعد میں دوبارہ ریفریش کر سکتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa số liệu đọc đã lưu vào bộ đệm của GaugeZ. Nhà cung cấp đã bật có thể làm mới lại sau."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 GaugeZ 的快取讀數。已啟用的提供者稍後可重新整理。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除 GaugeZ 缓存的数据。已启用的提供方稍后可重新刷新。"
          }
        }
      }
    },
