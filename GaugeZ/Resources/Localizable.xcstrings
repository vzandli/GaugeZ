    "Keychain access for %@ was declined. Use Retry to request access again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض الوصول إلى سلسلة المفاتيح لـ %@. استخدم إعادة المحاولة لطلب الوصول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ এর জন্য কীচেন অ্যাক্সেস প্রত্যাখ্যান করা হয়েছে। অ্যাক্সেসের অনুরোধ করতে 'পুনরায় চেষ্টা করুন' ব্যবহার করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pristup Keychainu za %@ je odbijen. Koristite 'Pokušaj ponovo' da zatražite pristup."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Schlüsselbund-Zugriff für %@ wurde abgelehnt. Verwenden Sie „Wiederholen“, um den Zugriff erneut anzufordern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keychain access for %@ was declined. Use Retry to request access again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se denegó el acceso al Llavero para %@. Usa Reintentar para solicitar acceso de nuevo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinanggihan ang access sa Keychain para sa %@. Gamitin ang Subukang Muli upang humiling muli ng access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au trousseau d’accès pour %@ a été refusé. Cliquez sur Réessayer pour demander à nouveau l’accès."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ के लिए कीचेन एक्सेस अस्वीकार कर दिया गया। एक्सेस का पुनः अनुरोध करने के लिए 'पुनः प्रयास करें' का उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso al Portachiavi per %@ è stato rifiutato. Usa Riprova per richiedere nuovamente l’accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のキーチェーンアクセスが拒否されました。「再試行」をクリックしてアクセスを再度要求してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 대한 키체인 접근이 거부되었습니다. 접근을 다시 요청하려면 '재시도'를 사용하십시오."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ साठी कीचेन अ‍ॅक्सेस नाकारला गेला. पुन्हा अ‍ॅक्सेसची विनंती करण्यासाठी 'पुन्हा प्रयत्न करा' वापरा."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso às Chaves para %@ foi recusado. Use Tentar Novamente para solicitar acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к Связке ключей для %@ отклонен. Нажмите «Повторить», чтобы запросить доступ снова."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-க்கான கீசெயின் அணுகல் நிராகரிக்கப்பட்டது. மீண்டும் அணுகலைக் கோர மீண்டும் முயற்சி செய் என்பதைப் பயன்படுத்தவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ కోసం Keychain యాక్సెస్ తిరస్కరించబడింది. యాక్సెస్‌ను మళ్లీ అభ్యర్థించడానికి మళ్లీ ప్రయత్నించు ఉపయోగించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ için Anahtar Zinciri erişimi reddedildi. Erişimi tekrar istemek için Yeniden Dene'yi kullanın."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کے لیے کی چین تک رسائی مسترد کر دی گئی۔ دوبارہ رسائی مانگنے کے لیے 'دوبارہ کوشش کریں' استعمال کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập Chuỗi khóa cho %@ đã bị từ chối. Sử dụng Thử lại để yêu cầu quyền truy cập lần nữa."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已拒絕 %@ 的「鑰匙圈」存取權限。按「重試」以再次要求存取。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对 %@ 的钥匙串访问已被拒绝。请点击“重试”以再次请求访问权限。"
          }
        }
      }
    },
