    "Claude Code cleared this sign-in. The last reading is kept until you sign in again." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسح Claude Code تسجيل الدخول هذا. تُحفظ آخر قراءة حتى تسجّل الدخول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code এই সাইন-ইন মুছে দিয়েছে। আবার সাইন ইন না করা পর্যন্ত শেষ রিডিং রাখা হয়েছে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code je obrisao ovu prijavu. Posljednje očitanje se čuva dok se ponovo ne prijavite."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code hat diese Anmeldung gelöscht. Der letzte Messwert bleibt erhalten, bis Sie sich erneut anmelden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code cleared this sign-in. The last reading is kept until you sign in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code borró este inicio de sesión. La última lectura se conserva hasta que vuelvas a iniciar sesión."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Binura ng Claude Code ang sign-in na ito. Pinananatili ang huling reading hanggang mag-sign in ka ulit."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code a effacé cette connexion. La dernière lecture est conservée jusqu’à votre reconnexion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code ने यह साइन-इन हटा दिया। दोबारा साइन इन करने तक आखिरी रीडिंग रखी गई है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code ha cancellato questo accesso. L’ultima lettura resta finché non accedi di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Codeがこのサインインを消去しました。再度サインインするまで最後の値を保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code가 이 로그인을 지웠습니다. 다시 로그인할 때까지 마지막 값을 유지합니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code ने हे साइन-इन पुसले. पुन्हा साइन इन करेपर्यंत शेवटचे रीडिंग ठेवले आहे."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Claude Code apagou este login. A última leitura fica guardada até você entrar de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code удалил этот вход. Последние показания сохраняются, пока вы не войдёте снова."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code இந்த உள்நுழைவை அழித்தது. மீண்டும் உள்நுழையும் வரை கடைசி அளவீடு வைக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code ఈ సైన్-ఇన్‌ను తొలగించింది. మళ్లీ సైన్ ఇన్ చేసే వరకు చివరి రీడింగ్ ఉంచబడుతుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code bu girişi sildi. Yeniden giriş yapana kadar son okuma korunur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code نے یہ سائن ان مٹا دیا۔ دوبارہ سائن ان کرنے تک آخری ریڈنگ محفوظ رہے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code đã xóa đăng nhập này. Số liệu gần nhất được giữ cho đến khi bạn đăng nhập lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 已清除此登入。最後讀數會保留至你再次登入。"
