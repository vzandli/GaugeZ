    "Rate limited. Next retry at %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تجاوز حد المعدل. إعادة المحاولة التالية في %@."
