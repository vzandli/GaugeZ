      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ حصص Copilot باستخدام GH_TOKEN أو تسجيل دخول واجهة سطر أوامر GitHub. شغّل gh auth login للاتصال."
          }
