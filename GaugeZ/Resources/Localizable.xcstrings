    "Drag handle to reposition GaugeZ horizontally" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب المقبض لتغيير موضع GaugeZ أفقيًا"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ অনুভূমিকভাবে সরাতে হ্যান্ডেলটি টানুন"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite ručicu za horizontalno premještanje aplikacije GaugeZ"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Griff ziehen, um GaugeZ horizontal neu zu positionieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag handle to reposition GaugeZ horizontally"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra el control para reposicionar GaugeZ horizontalmente"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-drag ang hawakan upang muling iposisyon ang GaugeZ nang pahalang"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser la poignée pour repositionner GaugeZ horizontalement"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ को क्षैतिज रूप से स्थानांतरित करने के लिए हैंडल खींचें"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina la maniglia per riposizionare GaugeZ in orizzontale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハンドルをドラッグしてGaugeZを水平方向に移動"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "핸들을 드래그하여 GaugeZ를 수평으로 위치 이동"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ आडव्या दिशेने हलवण्यासाठी हँडल ड्रॅग करा"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste a alça para reposicionar o GaugeZ horizontalmente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потяните за маркер, чтобы переместить GaugeZ по горизонтали"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ-ஐக் கிடைமட்டமாக மாற்ற பிடியை இழுக்கவும்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZని అడ్డంగా మార్చడానికి హ్యాండిల్‌ని లాగండి"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ'yi yatay olarak yeniden konumlandırmak için tutamacı sürükleyin"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ کی افقی پوزیشن تبدیل کرنے کے لیے ہینڈل ڈریگ کریں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo tay cầm để định vị lại GaugeZ theo chiều ngang"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖曳控點以水平重新放置 GaugeZ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动手柄水平移动 GaugeZ"
          }
        }
      }
    },
