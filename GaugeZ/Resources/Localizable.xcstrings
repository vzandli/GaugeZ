        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS لاگ ان آئٹم کو اپ ڈیٹ نہ کر سکا۔ GaugeZ کو Applications فولڈر میں منتقل کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS không thể cập nhật mục đăng nhập. Hãy di chuyển GaugeZ vào Ứng dụng và thử lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
