            "value" : "Claude డెస్క్‌టాప్ వినియోగ లాగ్‌ను లేదా Keychain నుండి డిఫాల్ట్ Claude Code CLI సైన్-ఇన్‌ను చదువుతుంది."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude masaüstü kullanım günlüğünü veya Anahtar Zincirinden saptanmış Claude Code CLI girişini okur."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude ڈیسک ٹاپ کے استعمال کا لاگ، یا کی چین سے ڈیفالٹ Claude Code CLI سائن ان پڑھتا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đọc nhật ký sử dụng của Claude cho máy tính hoặc thông tin đăng nhập mặc định của Claude Code CLI từ Chuỗi khóa."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀取 Claude 桌面版用量記錄，或從「鑰匙圈」讀取預設的 Claude Code CLI 登入資訊。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取 Claude 桌面用量日志，或从钥匙串中读取默认 Claude Code CLI 登录凭据。"
          }
        }
      }
    },
