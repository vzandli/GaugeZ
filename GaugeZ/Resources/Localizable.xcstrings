    "Open Claude Code and sign in, then retry." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح Claude Code وسجّل الدخول، ثم أعد المحاولة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code খুলুন এবং সাইন ইন করুন, তারপর আবার চেষ্টা করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otvorite Claude Code i prijavite se, pa pokušajte ponovo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnen Sie Claude Code, melden Sie sich an und versuchen Sie es erneut."
