    "Quota unavailable. Derived locally: %lld model turns today." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحصة غير متوفرة. مشتقة محليًا: %lld دور نموذج اليوم."
