    "MiniMax rejected the key. Check the key and the region in Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض MiniMax المفتاح. تحقق من المفتاح والمنطقة في الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax কী প্রত্যাখ্যান করেছে। সেটিংসে কী এবং অঞ্চল পরীক্ষা করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax je odbio ključ. Provjerite ključ i regiju u Postavkama."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax hat den Schlüssel abgelehnt. Prüfen Sie Schlüssel und Region in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax rejected the key. Check the key and the region in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax rechazó la clave. Revisa la clave y la región en Ajustes."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinanggihan ng MiniMax ang key. Tingnan ang key at ang rehiyon sa Mga Setting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax a rejeté la clé. Vérifiez la clé et la région dans les Réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax ने कुंजी अस्वीकार कर दी। सेटिंग्ज़ में कुंजी और क्षेत्र जांचें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax ha rifiutato la chiave. Controlla la chiave e la regione nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMaxがキーを拒否しました。設定でキーとリージョンを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MiniMax가 키를 거부했습니다. 설정에서 키와 지역을 확인하십시오."
          }
        },
