    "Disabling a provider removes it from the rail and clears its cached values." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي تعطيل المزود إلى إزالته من الشريط ومسح قيمه المخزنة مؤقتًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রদানকারীকে নিষ্ক্রিয় করলে এটি রেল থেকে অপসারিত হয় এবং ক্যাশ করা মান মুছে যায়।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onemogućavanje pružaoca usluge uklanja ga s trake i briše njegove keširane vrijednosti."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Deaktivieren eines Anbieters entfernt ihn aus der Leiste und löscht seine zwischengespeicherten Werte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabling a provider removes it from the rail and clears its cached values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivar un proveedor lo elimina de la barra y borra sus valores en caché."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pag-disable sa isang provider ay nag-aalis nito sa rail at nagbubura ng mga naka-cache na value nito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver un fournisseur le retire du rail et efface ses valeurs en cache."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रदाता को अक्षम करने से वह रेल से हट जाता है और उसके कैश्ड मान साफ़ हो जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disabilitazione di un provider lo rimuove dalla barra e ne cancella i valori memorizzati nella cache."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダーを無効にすると、レールから削除され、キャッシュされた値が消去されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제공자를 비활성화하면 레일에서 제거되고 캐시된 값이 지워집니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रदात्याला अक्षम केल्याने तो रेलमधून काढला जातो आणि त्याचे कॅश केलेले मूल्य साफ होते."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativar um provedor o remove da barra e apaga os valores em cache."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отключение провайдера убирает его с панели и очищает кэшированные данные."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "வழங்குநரை முடக்குவது அதை ரயிலில் இருந்து அகற்றி, அதன் தற்காலிக சேமிப்பு மதிப்புகளை அழிக்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ప్రొవైడర్‌ను డిసేబుల్ చేయడం వలన అది రైల్ నుండి తీసివేయబడుతుంది మరియు దాని కాష్ విలువలు తొలగించబడతాయి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sağlayıcıyı devre dışı bırakmak onu şeritten kaldırır ve önbelleğe alınan değerlerini temizler."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی فراہم کنندہ کو غیر فعال کرنے سے وہ ریل سے ہٹ جاتا ہے اور اس کی کیش شدہ ویلیوز صاف ہو جاتی ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt nhà cung cấp sẽ xóa nhà cung cấp đó khỏi thanh viền và xóa các giá trị đã lưu trong bộ đệm."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用提供者會將其從邊欄中移除，並清除其快取數值。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停用提供方会将其从边栏移除并清除其缓存数据。"
          }
        }
      }
    },
