    "A Dock icon while GaugeZ is running, plus the menu bar item." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيقونة في Dock أثناء تشغيل GaugeZ، بالإضافة إلى عنصر شريط القوائم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GaugeZ চলাকালীন ডক আইকন এবং মেনু বার আইটেম।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikona u Docku dok GaugeZ radi, plus stavka na traci s menijem."
