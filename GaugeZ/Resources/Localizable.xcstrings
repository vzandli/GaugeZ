    "Codex app-server could not provide usage. Open Codex and retry." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على خادم تطبيق Codex تقديم الاستخدام. افتح Codex وأعد المحاولة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex অ্যাপ-সার্ভার ব্যবহারের তথ্য দিতে পারেনি। Codex খুলুন এবং পুনরায় চেষ্টা করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex app-server nije mogao pružiti podatke o korištenju. Otvorite Codex i pokušajte ponovo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Codex-App-Server konnte die Nutzung nicht bereitstellen. Öffnen Sie Codex und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex app-server could not provide usage. Open Codex and retry."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de la app de Codex no pudo proporcionar el uso. Abre Codex y vuelve a intentarlo."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi maibigay ng Codex app-server ang paggamit. Buksan ang Codex at subukang muli."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le serveur d’application Codex n’a pas pu fournir l’utilisation. Ouvrez Codex et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex ऐप-सर्वर उपयोग विवरण प्रदान नहीं कर सका। Codex खोलें और पुनः प्रयास करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il server dell’app Codex non ha potuto fornire l’utilizzo. Apri Codex e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex app-serverから使用状況を取得できませんでした。Codexを開いて再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex app-server에서 사용량을 제공할 수 없습니다. Codex를 열고 다시 시도하십시오."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex अ‍ॅप-सर्व्हर वापर प्रदान करू शकला नाही. Codex उघडा आणि पुन्हा प्रयत्न करा."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O servidor local do Codex não pôde fornecer os dados de uso. Abra o Codex e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервер приложения Codex не смог предоставить данные об использовании. Откройте Codex и повторите попытку."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex app-server பயன்பாட்டை வழங்க முடியவில்லை. Codex-ஐத் திறந்து மீண்டும் முயற்சிக்கவும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex app-server వినియోగాన్ని అందించలేకపోయింది. Codex తెరిచి మళ్లీ ప్రయత్నించండి."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex uygulama sunucusu kullanımı sağlayamadı. Codex'i açıp yeniden deneyin."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex ایپ سرور استعمال فراہم نہیں کر سکا۔ Codex کھولیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máy chủ ứng dụng Codex không thể cung cấp mức sử dụng. Hãy mở Codex và thử lại."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex app-server 無法提供用量。請開啟 Codex 並重試。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex app-server 无法提供用量数据。请打开 Codex 并重试。"
          }
        }
      }
