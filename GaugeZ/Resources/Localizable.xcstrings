    "Step aside while a full-screen app owns the display" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التنحي جانبًا أثناء استحواذ تطبيق بملء الشاشة على الشاشة"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো ফুল-স্ক্রিন অ্যাপ ডিসপ্লে দখল করলে সরে যান"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skloni se dok aplikacija na cijelom ekranu koristi ekran"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur Seite treten, solange eine Vollbild-App den Bildschirm belegt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Step aside while a full-screen app owns the display"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aparta mientras una app a pantalla completa ocupa la pantalla"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umurong habang may full-screen na app na gumagamit ng display"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’efface tant qu’une app plein écran occupe l’écran"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब कोई फ़ुल-स्क्रीन ऐप डिस्प्ले ले, तब हट जाएं"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sposta mentre un’app a tutto schermo occupa lo schermo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フルスクリーンアプリが画面を占有している間は退避します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 화면 앱이 화면을 차지하는 동안 비켜 있기"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एखादे फुल-स्क्रीन अ‍ॅप डिस्प्ले व्यापत असताना बाजूला व्हा"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sai do caminho enquanto um app em tela cheia ocupa a tela"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уходит с экрана, пока его занимает полноэкранное приложение"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒரு முழுத்திரை செயலி திரையை ஆக்கிரமிக்கும்போது ஒதுங்கிக்கொள்ளும்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పూర్తి-స్క్రీన్ యాప్ డిస్‌ప్లేను ఆక్రమించినప్పుడు పక్కకు తప్పుకుంటుంది"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranı tam ekran bir uygulama kullanırken kenara çekilir"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب کوئی فل اسکرین ایپ ڈسپلے سنبھالے تو ایک طرف ہو جائیں"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhường chỗ khi một ứng dụng toàn màn hình chiếm màn hình"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
